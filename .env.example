# ============================================================
# 匿名回音 · 环境变量示例
# 生产环境必填项已用 [必填] 标注；未配置 LLM provider 时自动使用本地确定性归一化。
# 复制为 .env 后由 docker compose 自动加载：cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=production
COZE_PROJECT_ENV=PROD
PORT=5000

# ---------- 密钥 [必填，生产必须显式提供，禁止使用默认值] ----------
# JWT 签名密钥。必填，建议：openssl rand -base64 48
JWT_SECRET=
# 消息与身份主密钥。必填，必须是 base64 编码的 32 字节（AES-256）：
#   生成：openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=

# ---------- 数据库 ----------
# 生产必填：PostgreSQL 连接串。未设置时（开发态）降级本地 PGlite（数据落 DATA_DIR）。
DATABASE_URL=
# 数据库驱动：pg（默认，需 DATABASE_URL）| pglite（强制本地）。留空时按 DATABASE_URL 自动判定。
DB_DRIVER=
# 本地数据目录（PGlite / 密钥 / 分片 / 审计日志落盘位置）。
# 默认探测顺序：DATA_DIR → ${COZE_WORKSPACE_PATH}/.data → cwd/.data → os.tmpdir()/echo-room-data
DATA_DIR=

# ---------- Redis [必填，多实例实时广播] ----------
REDIS_URL=redis://redis:6379

# ---------- 身份保险库 Shamir 门限 ----------
VAULT_K=2
VAULT_N=3
# 启动自动解封（仅限受信单管理员环境；默认 false）：
# - false（推荐）：由 >=K 名分片持有人通过 break-glass 接口在启动后人工解封，
#   平时任何人都无法单方面溯源 —— 这是本项目匿名性承诺的基石。
# - true：启动即生成/解封并把分片落库备份，会削弱匿名性保证；
#   生产需要此行为时必须显式设置，禁止依赖代码默认值。
VAULT_AUTO_BOOTSTRAP=false
# 自动化/免人工场景：填入 >=K 个分片实现启动自动解封。生产【强烈建议留空】。
VAULT_AUTO_UNSEAL_SHARES=

# ---------- 管理员与准入 ----------
# 逗号分隔的用户名（登录后自动获得管理员角色，本身仍需通过邀请码注册）
ADMIN_USERNAMES=admin
# 系统启动时写入的可复用引导邀请码（逗号分隔）。
# 留空则启动时不注入任何邀请码，需通过管理后台 / vault-cli invite 签发（推荐）。
BOOTSTRAP_INVITE_CODES=
# 每用户每分钟最大发消息条数
RATE_LIMIT_PER_MINUTE=12
MAX_MESSAGE_LENGTH=1000
# 登录会话有效期（秒），默认 12 小时
TOKEN_TTL_SECONDS=43200

# ---------- LLM 语气归一化 ----------
# 总开关：关掉则完全不改写；开着但 provider=off 时走本地确定性规则（折叠重复标点等）
LLM_NORMALIZE_ENABLED=true
# provider 可选：off | openai | ollama | coze
LLM_PROVIDER=off
# provider 故障策略：passthrough=放行原文（默认，保可用）；reject=拒绝发送（保匿名强度）
LLM_ON_FAILURE=passthrough
LLM_TIMEOUT_MS=8000
# OpenAI 兼容（含任意兼容网关 / Azure 兼容端点）
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
# 本地 Ollama（docker compose 中服务名为 ollama）
LLM_OLLAMA_BASE_URL=http://ollama:11434
LLM_OLLAMA_MODEL=qwen2.5:7b
# 扣子智能体（LLM_PROVIDER=coze 时必填，留空且 provider=coze 将启动失败）：
# 填你的扣子智能体部署域名（不含末尾斜杠）。
LLM_COZE_API_URL=
# 扣子平台项目 ID（19 位整数，LLM_PROVIDER=coze 时必填，生产缺失将启动失败）。
LLM_COZE_PROJECT_ID=
# 智能体 Token 建议通过部署平台 env 注入，勿写进代码/仓库。
LLM_COZE_API_TOKEN=

# ---------- OIDC（M1 预留，默认关闭） ----------
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ---------- 平台注入（一般不需要手填） ----------
# 扣子编程平台注入的会话工作区路径（数据默认落 ${COZE_WORKSPACE_PATH}/.data）；自托管时忽略。
COZE_WORKSPACE_PATH=