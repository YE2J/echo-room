# ============================================================
# 匿名回音 · 环境变量示例
# 生产环境必填项已用 [必填] 标注；未配置 LLM provider 时自动使用本地确定性归一化。
# 复制为 .env 后由 docker compose 自动加载：cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=production
COZE_PROJECT_ENV=PROD
PORT=5000

# ---------- 密钥 [必填，生产必须显式提供，禁止使用默认值] ----------
# JWT 签名密钥：至少 32 字符随机字符串
JWT_SECRET=please-generate-with-openssl-rand-base64-48
# 消息与身份主密钥：必须是 base64 编码的 32 字节（AES-256）
# 生成命令：openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32_OUTPUT==

# ---------- 数据库 [必填] ----------
# docker compose 内部服务名 postgres；自行部署时改成真实连接串
DATABASE_URL=postgres://echo:echo_pw_change_me@postgres:5432/echoroom

# ---------- Redis [必填，多实例实时广播] ----------
REDIS_URL=redis://redis:6379

# ---------- 身份保险库 Shamir 门限 ----------
VAULT_K=2
VAULT_N=3
# 仅限自动化/测试：填入 >=K 个分片实现启动自动解封。生产环境【强烈建议留空】，
# 改由 >=K 名分片持有人通过 break-glass 接口在启动后人工解封，做到平时无法溯源。
VAULT_AUTO_UNSEAL_SHARES=

# ---------- 管理员与准入 ----------
# 逗号分隔的用户名（登录后自动获得管理员角色，本身仍需通过邀请码注册）
ADMIN_USERNAMES=admin
# 系统启动时写入的可复用引导邀请码（逗号分隔），上线后建议用管理后台轮换并在此清空
BOOTSTRAP_INVITE_CODES=WELCOME-2025
# 每用户每分钟最大发消息条数
RATE_LIMIT_PER_MINUTE=12
MAX_MESSAGE_LENGTH=1000
# 登录会话有效期（秒），默认 12 小时
TOKEN_TTL_SECONDS=43200

# ---------- LLM 语气归一化 ----------
# 总开关：关掉则完全不改写；开着但 provider=off 时走本地确定性规则（折叠重复标点等）
LLM_NORMALIZE_ENABLED=true
# provider 可选：off | openai | ollama
LLM_PROVIDER=off
# provider 故障策略：passthrough=放行原文（默认，保可用）；reject=拒绝发送（保匿名强度）
LLM_ON_FAILURE=passthrough
LLM_TIMEOUT_MS=8000
# OpenAI 兼容（含任意兼容网关 / Azure 兼容端点）
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
# 本地 Ollama（docker compose 中服务名为 ollama）
LLM_OLLAMA_BASE_URL=http://ollama:11434
LLM_OLLAMA_MODEL=qwen2.5:7b

# ---------- OIDC（M1 预留，默认关闭） ----------
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
